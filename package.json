{
  "name": "llamadas-atencion-api",
  "version": "1.0.0",
  "description": "Sistema de llamadas de atencion (ClickUp -> Slack) sobre Cloud Run + MySQL",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "set-claims": "tsx --env-file-if-exists=.env scripts/set-claims.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "test:smoke": "vitest run test/smoke",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2",
    "firebase-admin": "^13.0.2",
    "mysql2": "^3.23.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "protobufjs@7.6.4": true
  }
}
