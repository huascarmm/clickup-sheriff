# ============================================================================
# Variables de entorno. En produccion NO se usa este archivo:
# los secretos viven en Secret Manager y se inyectan a Cloud Run.
# Este archivo es solo referencia y para desarrollo local.
# ============================================================================

# --- Proyecto (solo Firebase Auth: roles/permisos del panel) ---
FIREBASE_PROJECT_ID=mi-proyecto-gcp

# --- MySQL (datos de negocio) ---
# Se recomienda una base/schema DEDICADO para tests: test/helpers.ts trunca
# todas las tablas antes de cada test.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=llamadas_atencion

# TLS: la base vive fuera de GCP (servidor propio), asi que el trafico sale
# por internet publico. En produccion MYSQL_SSL=true es obligatorio, no
# opcional. MYSQL_SSL_CA es el contenido PEM del certificado CA del servidor
# (pegado tal cual, no una ruta de archivo). En local contra un MySQL sin TLS,
# deja MYSQL_SSL en blanco/false.
MYSQL_SSL=false
# MYSQL_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Ultimo recurso si no se tiene la CA a mano (cifra pero NO valida el
# certificado del servidor; no recomendado en produccion):
# MYSQL_SSL_REJECT_UNAUTHORIZED=false

# --- Secretos (Secret Manager en produccion) ---
# Token de la API de ClickUp (pk_...). ROTAR el que estaba en el codigo viejo.
CLICKUP_TOKEN=pk_xxxxxxxx
# Bot token de Slack (xoxb-...). ROTAR el que estaba en el codigo viejo.
SLACK_BOT_TOKEN=xoxb-xxxxxxxx
# Secreto compartido que ClickUp manda en el query ?secret=... del webhook.
WEBHOOK_SECRET=cambia-esto-por-algo-largo-y-random

# --- Auth admin ---
# Correos con acceso al panel, separados por coma. Los roles finos (admin vs
# superadmin) se controlan por custom claims; esta lista es un cerrojo extra.
# Incluye TODOS los correos con acceso (admins y superadmins), separados por coma.
ADMIN_EMAILS=tu-correo@empresa.com

# --- CORS (solo si el panel corre en otro origen sin rewrite de Hosting) ---
ALLOWED_ORIGIN=

# --- Local only: credenciales de servicio para firebase-admin (Auth) ---
# En Cloud Run NO se define: se usa Application Default Credentials (ADC).
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

PORT=8080
